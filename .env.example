DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
BETTER_AUTH_SECRET="your_better_auth_secret_here"
BETTER_AUTH_URL="https://your-vercel-url.vercel.app"

# Required: Set this to your deployed Vercel URL (e.g. https://fanoon-consultants.vercel.app)
NEXT_PUBLIC_APP_URL="https://your-vercel-url.vercel.app"

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Resend - Email delivery for career applications (https://resend.com)
RESEND_API_KEY="re_your_resend_api_key_here"
# The email address that will receive all job applications
ADMIN_EMAIL="your@email.com"
# Sender email shown on outgoing emails (must be from a verified Resend domain in production)
RESEND_FROM_EMAIL="Fanoon Careers <onboarding@resend.dev>"

IMGBB_API_KEY=
